SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional. Overrides the default Gemini model id (gemini-3.6-flash).
# Do not use gemini-2.5-* — Google blocks those for new keys/projects.
# If Canner still has a 2.5 id, the app remaps it automatically; clear or
# update the env var when you can so logs stay honest.
GEMINI_MODEL="gemini-3.6-flash"
# Optional. Comma-separated ladder tried when the primary (then each previous
# step) is overloaded, out of free-tier quota, or refused as a retired id.
# Each model has its own pool. Retired 2.5 ids in this list are remapped.
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview"
